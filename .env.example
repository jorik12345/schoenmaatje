# Supabase → Project Settings → API Keys. Zonder deze twee draait de site op voorbeelddata.
PUBLIC_SUPABASE_URL=https://jouwproject.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile → site key. Leeg laten zolang captcha in Supabase uit staat.
PUBLIC_TURNSTILE_SITE_KEY=
