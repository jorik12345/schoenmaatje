---
const steps = [
  ['Bied je schoen aan', 'Foto, merk, maat en of het de linker of rechter is. Verkoop hem, geef hem weg of ruil hem.'],
  ['Vind wat past', 'Filter op links of rechts, maat en prijs. Zie je iemand met jouw maat? Bekijk alles wat die aanbiedt.'],
  ['Regel het samen', 'Afspreken of opsturen, betalen met een betaalverzoek of contant. Schoenmaatje rekent geen kosten.'],
];
---
<div class="sm-steps">
  {steps.map(([title, text], i) => (
    <div class="sm-step"><span class="sm-step__n">{i + 1}</span><h3>{title}</h3><p>{text}</p></div>
  ))}
</div>
