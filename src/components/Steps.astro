---
const steps = [
  ['Bied je schoen aan', 'Foto, merk, maat en of het de linker of rechter is. Klaar in twee minuten.'],
  ['Krijg een match', 'Zoekt iemand met dezelfde maat precies jouw kant? Dan krijgen jullie allebei een bericht.'],
  ['Ruil onderling', 'Afspreken of opsturen: jullie kiezen. Ruilen is gratis, verzenden regel je samen.'],
];
---
<div class="sm-steps">
  {steps.map(([title, text], i) => (
    <div class="sm-step"><span class="sm-step__n">{i + 1}</span><h3>{title}</h3><p>{text}</p></div>
  ))}
</div>
