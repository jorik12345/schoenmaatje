---
import { COLORS, OFFER_LABELS, formatEuro, swatchBackground, type ColorName } from '../data/shoes';
import { FITS, MAX_PRICES, OFFERS, SIZES, type Filters } from '../data/filters';
import type { Facets } from '../lib/listings';
interface Props { filters: Filters; facets: Facets }
const { filters, facets } = Astro.props;
// Gekozen merken blijven zichtbaar, ook als ze (nu) geen actieve advertenties meer hebben.
const brands = [...facets.brands, ...filters.merk.filter((m) => !facets.brands.some(([b]) => b === m)).map((m): [string, number] => [m, 0])];
const groupStyle = 'margin:0;border-left:0;border-right:0;border-bottom:0';
const legendStyle = 'padding:4px 0 0;float:left;width:100%';
---
<form class="sm-filters" method="GET" action="/aanbod" aria-label="Filters" data-filters>
  <input type="hidden" name="sorteer" value={filters.sorteer} />
  <fieldset class="sm-filters__group" style={groupStyle}>
    <legend class="sm-filters__head" style={legendStyle}><span class="sm-filters__title">Welke schoen zoek je?</span></legend>
    <div class="sm-seg sm-seg--block" style="grid-template-columns:repeat(3,1fr)">
      <label><input type="radio" name="zijde" value="" checked={!filters.zijde} /><span>Beide</span></label>
      <label><input type="radio" name="zijde" value="links" checked={filters.zijde === 'links'} /><span>Links</span></label>
      <label><input type="radio" name="zijde" value="rechts" checked={filters.zijde === 'rechts'} /><span>Rechts</span></label>
    </div>
  </fieldset>
  <fieldset class="sm-filters__group" style={groupStyle}>
    <legend class="sm-filters__head" style={legendStyle}><span class="sm-filters__title">Soort</span></legend>
    {OFFERS.map((o) => (
      <label class="sm-check"><input type="checkbox" name="soort" value={o} checked={filters.soort.includes(o)} />{OFFER_LABELS[o]} <span class="sm-count">{facets.offers[o] ?? 0}</span></label>
    ))}
  </fieldset>
  <fieldset class="sm-filters__group" style={groupStyle}>
    <legend class="sm-filters__head" style={legendStyle}><span class="sm-filters__title">Maximale prijs</span></legend>
    <label class="sm-check"><input type="radio" name="maxprijs" value="" checked={!filters.maxprijs} />Geen maximum</label>
    {MAX_PRICES.map((p) => (
      <label class="sm-check"><input type="radio" name="maxprijs" value={p} checked={filters.maxprijs === p} />Tot {formatEuro(p * 100)}</label>
    ))}
    <span class="sm-hint">Gratis en ruilen tellen altijd mee.</span>
  </fieldset>
  <fieldset class="sm-filters__group" style={groupStyle}>
    <legend class="sm-filters__head" style={legendStyle}><span class="sm-filters__title">Pasvorm</span></legend>
    {FITS.map((f) => (
      <label class="sm-check"><input type="checkbox" name="pasvorm" value={f} checked={filters.pasvorm.includes(f)} />{f} <span class="sm-count">{facets.fits[f] ?? 0}</span></label>
    ))}
  </fieldset>
  <fieldset class="sm-filters__group" style={groupStyle}>
    <legend class="sm-filters__head" style={legendStyle}><span class="sm-filters__title">Maat (EU)</span></legend>
    <div class="sm-sizes">
      {SIZES.map((s) => (
        <label><input type="checkbox" name="maat" value={s} checked={filters.maat.includes(s)} /><span>{s}</span></label>
      ))}
    </div>
    <span class="sm-hint">Een hele maat toont ook de halve maat erboven.</span>
  </fieldset>
  {brands.length > 0 && (
    <fieldset class="sm-filters__group" style={groupStyle}>
      <legend class="sm-filters__head" style={legendStyle}><span class="sm-filters__title">Merk</span></legend>
      {brands.map(([b, n]) => (
        <label class="sm-check"><input type="checkbox" name="merk" value={b} checked={filters.merk.includes(b)} />{b} <span class="sm-count">{n}</span></label>
      ))}
    </fieldset>
  )}
  <fieldset class="sm-filters__group" style={groupStyle}>
    <legend class="sm-filters__head" style={legendStyle}><span class="sm-filters__title">Kleur</span></legend>
    <div class="sm-swatches">
      {(Object.keys(COLORS) as ColorName[]).map((name) => (
        <label title={name}><input type="checkbox" name="kleur" value={name} checked={filters.kleur.includes(name)} aria-label={name} /><span class="sm-swatch" style={`background:${swatchBackground(name)}`}></span></label>
      ))}
    </div>
  </fieldset>
  <div class="sm-filters__group" data-submit-row>
    <button class="sm-btn sm-btn--primary sm-btn--block" type="submit">Toon resultaten</button>
  </div>
</form>
<script>
  // Met JavaScript: filters direct toepassen en de knop verbergen. Zonder JavaScript werkt de knop.
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  form?.querySelector<HTMLElement>('[data-submit-row]')?.setAttribute('hidden', '');
  form?.addEventListener('change', () => {
    // Lege velden (zoals zijde=Beide) niet in de URL zetten.
    const params = new URLSearchParams();
    for (const [k, v] of new FormData(form)) if (v !== '') params.append(k, String(v));
    location.href = `/aanbod${params.size ? `?${params}` : ''}`;
  });
</script>
