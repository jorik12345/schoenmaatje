---
import { COLORS, formatSize, relativeDate, type Shoe } from '../data/shoes';
import ShoeIcon from './ShoeIcon.astro';
import SideChip from './SideChip.astro';
interface Props { shoe: Shoe }
const { shoe } = Astro.props;
const isNew = Date.now() - new Date(shoe.addedAt).getTime() < 864e5;
---
<article class="sm-card">
  <div class="sm-card__img">
    <SideChip side={shoe.side} />
    {isNew && <span class="sm-card__new">Nieuw</span>}
    <ShoeIcon side={shoe.side} color={COLORS[shoe.color]} />
  </div>
  <div class="sm-card__body">
    <span class="sm-card__brand">{shoe.brand}</span>
    <h3 class="sm-card__title">{shoe.model}</h3>
    <div class="sm-card__tags">
      <span class="sm-tag">Maat {formatSize(shoe.size)}</span>
      <span class="sm-tag">{shoe.fit}</span>
      <span class="sm-tag">{shoe.condition}</span>
    </div>
    <div class="sm-card__foot"><span>{shoe.place}</span><span>{relativeDate(shoe.addedAt)}</span></div>
  </div>
</article>
