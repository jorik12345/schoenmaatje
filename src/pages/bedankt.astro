---
import Base from '../layouts/Base.astro';
---
<Base title="Bedankt">
  <div class="sm-wrap" style="padding-top:72px;padding-bottom:96px;max-width:720px">
    <span class="sm-kicker">Verstuurd</span>
    <h1 class="sm-hero__title" style="font-size:56px;margin:12px 0 18px">Bedankt, we hebben het ontvangen.</h1>
    <p class="sm-hero__lead">Je hoort van ons via het e-mailadres dat je hebt opgegeven.</p>
    <div class="sm-hero__cta"><a class="sm-btn sm-btn--primary" href="/aanbod">Bekijk het aanbod</a><a class="sm-btn sm-btn--secondary" href="/">Naar home</a></div>
  </div>
</Base>
