---
import Base from '../layouts/Base.astro';
---
<Base title="Account verwijderd">
  <div class="sm-wrap" style="padding-top:72px;padding-bottom:96px;max-width:720px">
    <span class="sm-kicker">Account verwijderd</span>
    <h1 class="sm-hero__title" style="font-size:56px;margin:12px 0 18px">Je account en gegevens zijn verwijderd.</h1>
    <p class="sm-hero__lead">Je advertenties, foto's en berichten staan niet meer op Schoenmaatje. Je bent altijd welkom om opnieuw een account aan te maken.</p>
    <div class="sm-hero__cta"><a class="sm-btn sm-btn--secondary" href="/">Naar home</a></div>
  </div>
</Base>
