---
export const prerender = false;

import Base from '../layouts/Base.astro';
import FilterPanel from '../components/FilterPanel.astro';
import ShoeCard from '../components/ShoeCard.astro';
import { SORTS, activeChips, parseFilters, parsePage } from '../data/filters';
import { getFacets, searchListings } from '../lib/listings';
import { cacheBriefly } from '../lib/cache';

const params = Astro.url.searchParams;
const filters = parseFilters(params);
const page = parsePage(params);
const [{ shoes: results, total }, facets] = await Promise.all([searchListings(filters, page), getFacets()]);
const chips = activeChips(params);
const withParam = (key: string, value: string) => {
  const next = new URLSearchParams(params);
  next.set(key, value);
  return `/aanbod?${next}`;
};
cacheBriefly(Astro);
---
<Base title="Aanbod" active="aanbod" description="Losse schoenen te koop, gratis of te ruil. Filter op links of rechts, maat, prijs, merk en kleur.">
  <div class="sm-wrap" style="padding-top:40px;padding-bottom:64px">
    <span class="sm-kicker">Aanbod</span>
    <h1 class="sm-h1" style="margin:6px 0 28px">Losse schoenen, links en rechts</h1>
    <div class="sm-layout-aanbod">
      <FilterPanel filters={filters} facets={facets} />
      <div>
        <div class="sm-toolbar">
          <span role="status"><b>{total} {total === 1 ? 'schoen' : 'schoenen'}</b> <span class="sm-muted">gevonden</span></span>
          <nav aria-label="Sorteren" style="display:flex;gap:4px;align-items:center">
            <span class="sm-label" style="margin-right:6px">Sorteer</span>
            {SORTS.map((o) => (
              <a class:list={['sm-btn sm-btn--sm', filters.sorteer === o.value ? 'sm-btn--secondary' : 'sm-btn--ghost']} href={withParam('sorteer', o.value)} aria-current={filters.sorteer === o.value ? 'true' : undefined}>{o.label}</a>
            ))}
          </nav>
        </div>
        {chips.length > 0 && (
          <div class="sm-active">
            {chips.map((c) => c.side
              ? <a class:list={['sm-side', c.side === 'links' ? 'sm-side--left' : 'sm-side--right']} href={c.href} aria-label={`Filter ${c.label} weghalen`} style="text-decoration:none">{c.label} ×</a>
              : <a class="sm-tag sm-tag--removable" href={c.href} aria-label={`Filter ${c.label} weghalen`} style="text-decoration:none">{c.label}</a>)}
            <a class="sm-filters__reset" href="/aanbod" style="margin-left:6px">Alles wissen</a>
          </div>
        )}
        {results.length > 0
          ? <div class="sm-grid sm-grid--3">{results.map((shoe) => <ShoeCard shoe={shoe} />)}</div>
          : <div class="sm-notice"><b>Geen schoenen met deze filters.</b>Haal een filter weg, of kom later terug: er komen steeds schoenen bij.</div>}
        {results.length < total && (
          <div style="display:flex;justify-content:center;align-items:center;gap:16px;margin-top:40px">
            <span class="sm-muted" style="font-size:15px">{results.length} van {total}</span>
            <a class="sm-btn sm-btn--secondary" href={withParam('pagina', String(page + 1))}>Meer laden</a>
          </div>
        )}
        {results.length > 0 && (
          <div class="sm-notice" style="margin-top:40px"><b>Heb je zelf een schoen over?</b><a href="/aanbieden">Bied hem aan</a>, dan vindt iemand anders misschien precies wat die zoekt.</div>
        )}
      </div>
    </div>
  </div>
</Base>
