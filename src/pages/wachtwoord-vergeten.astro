---
export const prerender = false;

import Base from '../layouts/Base.astro';
import Alert from '../components/Alert.astro';
import Turnstile from '../components/Turnstile.astro';
import { authErrorMessage } from '../lib/auth';

const { supabase } = Astro.locals;
let sent = false;
let error: string | null = null;

if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const captchaToken = String(form.get('cf-turnstile-response') ?? '') || undefined;
  if (!/^\S+@\S+\.\S+$/.test(email)) {
    error = 'Vul een geldig e-mailadres in.';
  } else {
    const { error: e } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${Astro.url.origin}/auth/bevestigen?naar=${encodeURIComponent('/account/wachtwoord')}`,
      captchaToken,
    });
    // Ook bij een onbekend adres dezelfde melding, zodat niet te achterhalen is wie een account heeft.
    if (e && e.status === 429) error = authErrorMessage(e);
    else sent = true;
  }
}
---
<Base title="Wachtwoord vergeten">
  <div class="sm-auth">
    <div>
      <span class="sm-kicker">Account</span>
      <h1 class="sm-h1" style="margin-top:6px">Wachtwoord vergeten</h1>
    </div>
    {sent ? (
      <Alert kind="success" title="Check je mail">Als er een account bij dit adres hoort, staat er een link in je mailbox om een nieuw wachtwoord te kiezen.</Alert>
    ) : (
      <>
        {error && <Alert kind="error" title="Dat lukte niet">{error}</Alert>}
        <form class="sm-auth__card" method="POST">
          <div class="sm-field">
            <label for="w-email">E-mailadres</label>
            <input id="w-email" name="email" type="email" class="sm-input" autocomplete="email" required />
          </div>
          <Turnstile />
          <button class="sm-btn sm-btn--primary sm-btn--block" type="submit">Stuur herstellink</button>
        </form>
      </>
    )}
    <p class="sm-auth__switch"><a href="/inloggen">Terug naar inloggen</a></p>
  </div>
</Base>
