---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden">
  <div class="sm-wrap" style="padding-top:72px;padding-bottom:96px;max-width:720px">
    <span class="sm-kicker">404</span>
    <h1 class="sm-hero__title" style="font-size:56px;margin:12px 0 18px">Deze pagina loopt niet meer mee.</h1>
    <p class="sm-hero__lead">Het adres klopt niet of de pagina is weg. Probeer het aanbod of ga terug naar home.</p>
    <div class="sm-hero__cta"><a class="sm-btn sm-btn--primary" href="/aanbod">Bekijk het aanbod</a><a class="sm-btn sm-btn--secondary" href="/">Naar home</a></div>
  </div>
</Base>
