---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import ShoeCard from '../components/ShoeCard.astro';
import SignupBlock from '../components/SignupBlock.astro';
import { shoes } from '../data/shoes';

const recent = [...shoes].sort((a, b) => b.addedAt.localeCompare(a.addedAt)).slice(0, 4);
const sizes = shoes.map((s) => s.size);
---
<Base title="Schoenmaatje" active="home">
  <Hero count={shoes.length} brands={new Set(shoes.map((s) => s.brand)).size} sizes={`${Math.floor(Math.min(...sizes))}–${Math.ceil(Math.max(...sizes))}`} />

  <section class="sm-section">
    <div class="sm-wrap">
      <div class="sm-section__head">
        <div><span class="sm-kicker">Net binnen</span><h2 class="sm-h1" style="margin-top:6px">Recent toegevoegd</h2></div>
        <a class="sm-btn sm-btn--secondary sm-btn--sm" href="/aanbod">Alle {shoes.length} schoenen</a>
      </div>
      <div class="sm-grid sm-grid--4">{recent.map((shoe) => <ShoeCard shoe={shoe} />)}</div>
    </div>
  </section>

  <section class="sm-section">
    <div class="sm-wrap">
      <span class="sm-kicker">Zo werkt het</span>
      <h2 class="sm-h1" style="margin:6px 0 24px">Drie stappen, geen gedoe.</h2>
      <Steps />
    </div>
  </section>

  <section class="sm-section" style="padding-bottom:64px">
    <div class="sm-wrap"><SignupBlock /></div>
  </section>
</Base>
